# Copiar a .env y completar. Nunca commitear el .env real (ver .gitignore).

# Cadena de conexión de Postgres (Neon, Railway, local, etc.)
# Ejemplo Neon: postgresql://usuario:password@ep-xxxx.neon.tech/nexo?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/nexo

# Puerto HTTP del servidor
PORT=4000

# Entorno: development | test | production
NODE_ENV=development

# Secretos de JWT — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar-este-valor-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambiar-este-otro-valor-tambien-largo-y-aleatorio

# Duración de tokens
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Tamaño máximo de archivo aceptado por el importador de Excel (bytes)
IMPORT_MAX_FILE_SIZE=10485760
